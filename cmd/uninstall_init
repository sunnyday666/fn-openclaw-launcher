#!/bin/bash

### 卸载前：停止启动器与其托管的 OpenClaw 网关。

LOG_FILE="${TRIM_PKGVAR}/uninstall.log"
log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

log_msg "uninstall requested"
"${TRIM_APPDEST}/cmd/main" stop >/dev/null 2>&1

# 兜底：清理可能残留的 OpenClaw 网关进程
GW_PID_FILE="${TRIM_PKGHOME}/data/var/gateway.pid"
if [ -r "${GW_PID_FILE}" ]; then
    pid=$(head -n 1 "${GW_PID_FILE}" | tr -d '[:space:]')
    case "${pid}" in
    '' | *[!0-9]*) ;;
    *)
        if kill -0 "${pid}" 2>/dev/null; then
            log_msg "killing leftover gateway pid ${pid}"
            kill -TERM "${pid}" 2>/dev/null
            sleep 3
            kill -KILL "${pid}" 2>/dev/null
        fi
        ;;
    esac
    rm -f "${GW_PID_FILE}"
fi

# 仅清理运行时缓存，保留用户数据（模型配置、会话、工作区）
rm -rf "${TRIM_PKGHOME}/data/cache" 2>/dev/null || true

log_msg "uninstall init done"
exit 0
