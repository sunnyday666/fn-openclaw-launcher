#!/bin/bash

### 安装完成：准备数据目录。OpenClaw 本体的下载与安装在首次打开应用时由
### 启动器在后台完成（安装包保持轻量，安装过程可快速返回）。

set -e

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${TRIM_PKGVAR}/info.log"
}

DATA_DIR="${TRIM_PKGHOME}/data"

log_msg "preparing data directories under ${DATA_DIR}"
mkdir -p \
    "${DATA_DIR}/runtime" \
    "${DATA_DIR}/openclaw" \
    "${DATA_DIR}/ocstate" \
    "${DATA_DIR}/ochome" \
    "${DATA_DIR}/workspace" \
    "${DATA_DIR}/logs" \
    "${DATA_DIR}/cache"

chmod 700 "${DATA_DIR}/ocstate" "${DATA_DIR}/ochome" 2>/dev/null || true

log_msg "install finished"
exit 0
