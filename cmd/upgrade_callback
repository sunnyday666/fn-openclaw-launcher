#!/bin/bash

### 升级后：数据目录位于 @apphome，升级不会覆盖；重新拉起服务即可。

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${TRIM_PKGVAR}/info.log"
}

DATA_DIR="${TRIM_PKGHOME}/data"
mkdir -p "${DATA_DIR}/logs" "${DATA_DIR}/cache" 2>/dev/null || true

log_msg "upgrade finished: ${TRIM_OLD_APPVER:-?} -> ${TRIM_APPVER:-?}"

"${TRIM_APPDEST}/cmd/main" start >/dev/null 2>&1

exit 0
